// Declarative Jenkinsfile for sheep-farm-ts
// Expects these Jenkins credentials to be set (names used below):
//   DOCKER_CREDENTIALS_ID  -> username/password for container registry (Docker Hub or GHCR)
//   K8S_KUBECONFIG_ID      -> kubeconfig file (optional; for deploy-to-k8s)
// Optional parameters (set in pipeline/job config or Jenkinsfile environment):
//   DOCKER_REGISTRY        -> e.g. docker.io/youruser  OR ghcr.io/youruser
//   DOCKER_REPO_PREFIX     -> e.g. youruser (used to form images)
//   DEPLOY_TO_K8S          -> "true" to apply k8s manifests
//   K8S_NAMESPACE          -> namespace to apply manifests (default: default)

pipeline {
  agent any

  environment {
    // set a default registry prefix; override in job config if needed
    DOCKER_REGISTRY = "${env.DOCKER_REGISTRY ?: 'docker.io'}"
    DOCKER_REPO_PREFIX = "${env.DOCKER_REPO_PREFIX ?: 'youruser'}"
    DEPLOY_TO_K8S = "${env.DEPLOY_TO_K8S ?: 'false'}"
    K8S_NAMESPACE = "${env.K8S_NAMESPACE ?: 'default'}"
    // image names (will tag with commit SHA and latest)
    BACKEND_IMAGE = "${env.DOCKER_REGISTRY}/${env.DOCKER_REPO_PREFIX}/sheep-backend"
    FRONTEND_IMAGE = "${env.DOCKER_REGISTRY}/${env.DOCKER_REPO_PREFIX}/sheep-frontend"
    // short commit id
    GIT_COMMIT_SHORT = "${env.GIT_COMMIT?.take(8) ?: 'local'}"
  }

  options {
    // keep build logs manageable
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timestamps()
    ansiColor('xterm')
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        script {
          // refresh short commit after checkout
          env.GIT_COMMIT_SHORT = sh(script: "git rev-parse --short=8 HEAD", returnStdout: true).trim()
        }
      }
    }

    stage('Install & Build Backend') {
      steps {
        dir('backend') {
          sh 'npm ci'
          sh 'npm run build'    // compiles TypeScript -> dist
        }
      }
    }

    stage('Install & Build Frontend') {
      steps {
        dir('frontend') {
          sh 'npm ci'
          sh 'npm run build'    // react-scripts build
        }
      }
    }

    stage('Optional: Run Tests') {
      when {
        expression { fileExists('backend/package.json') || fileExists('frontend/package.json') }
      }
      steps {
        echo "Skipping tests by default. Add test commands here if you have tests."
        // e.g. dir('backend') { sh 'npm test' }
        // e.g. dir('frontend') { sh 'npm test -- --watchAll=false' }
      }
    }

    stage('Build Docker Images') {
      steps {
        script {
          // Build backend image
          sh """
            docker build -t ${BACKEND_IMAGE}:${GIT_COMMIT_SHORT} -f backend/Dockerfile backend
            docker tag ${BACKEND_IMAGE}:${GIT_COMMIT_SHORT} ${BACKEND_IMAGE}:latest
          """
          // Build frontend image
          sh """
            docker build -t ${FRONTEND_IMAGE}:${GIT_COMMIT_SHORT} -f frontend/Dockerfile frontend
            docker tag ${FRONTEND_IMAGE}:${GIT_COMMIT_SHORT} ${FRONTEND_IMAGE}:latest
          """
        }
      }
    }

    stage('Push Images to Registry') {
      steps {
        script {
          // Using Jenkins credentials (username/password)
          withCredentials([usernamePassword(credentialsId: 'DOCKER_CREDENTIALS_ID', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
            sh 'echo "$DOCKER_PASS" | docker login ${DOCKER_REGISTRY} -u "$DOCKER_USER" --password-stdin'
            sh "docker push ${BACKEND_IMAGE}:${GIT_COMMIT_SHORT}"
            sh "docker push ${BACKEND_IMAGE}:latest"
            sh "docker push ${FRONTEND_IMAGE}:${GIT_COMMIT_SHORT}"
            sh "docker push ${FRONTEND_IMAGE}:latest"
            sh 'docker logout ${DOCKER_REGISTRY}'
          }
        }
      }
    }

    stage('Deploy to Kubernetes (optional)') {
      when {
        expression { return env.DEPLOY_TO_K8S == 'true' }
      }
      steps {
        script {
          // Requires kubeconfig file stored as "K8S_KUBECONFIG_ID" (Secret File credential)
          withCredentials([file(credentialsId: 'K8S_KUBECONFIG_ID', variable: 'KUBECONFIG_FILE')]) {
            // write kubeconfig to temp file and export KUBECONFIG
            sh 'export KUBECONFIG=$KUBECONFIG_FILE; echo "Using KUBECONFIG: $KUBECONFIG"'
            // Replace image placeholders in k8s manifests (create temp copies)
            sh """
              cp -r k8s /tmp/k8s-deploy
              sed -i 's|your-docker-registry/sheep-backend:latest|${BACKEND_IMAGE}:latest|g' /tmp/k8s-deploy/backend-deployment.yaml || true
              sed -i 's|your-docker-registry/sheep-frontend:latest|${FRONTEND_IMAGE}:latest|g' /tmp/k8s-deploy/frontend-deployment.yaml || true
              kubectl --namespace=${K8S_NAMESPACE} apply -f /tmp/k8s-deploy
            """
            // Optional: rollout status
            sh "kubectl --namespace=${K8S_NAMESPACE} rollout status deployment/sheep-backend --timeout=120s || true"
            sh "kubectl --namespace=${K8S_NAMESPACE} rollout status deployment/sheep-frontend --timeout=120s || true"
          }
        }
      }
    }
  } // stages

  post {
    success {
      echo "Pipeline finished successfully. Images pushed: ${BACKEND_IMAGE}:${GIT_COMMIT_SHORT}, ${FRONTEND_IMAGE}:${GIT_COMMIT_SHORT}"
    }
    failure {
      echo "Pipeline failed. Check console logs."
    }
    always {
      // cleanup local images to save disk on Jenkins agent
      sh """
        docker rmi ${BACKEND_IMAGE}:${GIT_COMMIT_SHORT} || true
        docker rmi ${BACKEND_IMAGE}:latest || true
        docker rmi ${FRONTEND_IMAGE}:${GIT_COMMIT_SHORT} || true
        docker rmi ${FRONTEND_IMAGE}:latest || true
      """
    }
  }
}
